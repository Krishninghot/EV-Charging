# ─── Backend ──────────────────────────────────────────────────────────────────

# SQLite database path (defaults to /tmp/ev_charging.db on Vercel)
# For local Windows dev, set this to a local path:
# DB_PATH=C:/Users/you/ev_charging.db
DB_PATH=/tmp/ev_charging.db

# CORS: comma-separated list of allowed frontend origins
# In production, set this to your actual Vercel frontend URL
# ALLOWED_ORIGINS=https://ev-charging.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────

# Backend API base URL (leave empty to use relative URLs — works on Vercel)
# Set this only if your backend is hosted on a separate domain
# VITE_API_BASE_URL=https://api.your-backend.com
VITE_API_BASE_URL=
